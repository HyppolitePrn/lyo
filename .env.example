# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://lyo:lyo_secret@localhost:5432/lyo?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_secure_random_string_of_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# OTEL_ENABLED=false keeps stdout logging but creates no OTLP exporter — use it
# when running the backend without the observability stack.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=lyo-backend
OTEL_SERVICE_VERSION=dev
APP_ENV=development
# Collector endpoint. Inside docker-compose this is overridden to
# http://otel-collector:4317; localhost is for `go run ./cmd/server`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Powers GET /admin/supervision. Leave blank to serve incidents without live
# metrics. Inside docker-compose this is overridden to http://prometheus:9090.
PROMETHEUS_URL=http://localhost:9090
# Shared secret Grafana presents on POST /internal/alerts. Must match
# ALERT_WEBHOOK_SECRET in docker/.env, which Grafana reads for its contact
# point. Blank disables the endpoint rather than leaving it unauthenticated.
ALERT_WEBHOOK_SECRET=change_me_to_a_random_string

# ─── Streaming ────────────────────────────────────────────────────────────────
STREAM_MAX_LISTENERS=500
STREAM_BUFFER_SIZE=65536

# ─── Mail ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lyo.app

# ─── Track storage (S3-compatible — MinIO locally via docker/docker-compose.yml) ─
# Leave every S3_* var blank to disable track uploads (gated by the track_uploads
# feature flag; POST /tracks/upload-url and track deletion will fail cleanly).
S3_BUCKET_NAME=lyo-tracks
S3_REGION=us-east-1
# MinIO root creds — dev-only convenience values, not real secrets. Rotate for
# any shared/public deployment (see docker-compose.prod.yml MINIO_ROOT_* vars).
S3_ACCESS_KEY_ID=lyo_minio
S3_SECRET_ACCESS_KEY=lyo_minio_secret
# S3_ENDPOINT: host the BACKEND container uses to reach storage (Docker-internal
# service name below). Leave blank to use real AWS S3 instead of MinIO.
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT: host the MOBILE APP uses for presigned uploads and audio
# playback — must be reachable from wherever the app runs.
#   Android emulator            → http://10.0.2.2:9000
#   Physical device / other LAN → http://<your-machine-LAN-IP>:9000
#   iOS simulator / same machine → http://localhost:9000 (default below)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# MinIO server admin credentials (read by docker-compose.yml, not the Go app).
MINIO_ROOT_USER=lyo_minio
MINIO_ROOT_PASSWORD=lyo_minio_secret
